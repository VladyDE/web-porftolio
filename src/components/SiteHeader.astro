---
import { copy, profile, type Locale } from '../data/portfolio';
import Icon from './Icon.astro';

interface Props {
  lang: Locale;
  currentPage: 'home' | 'dashboards';
}

const { lang, currentPage } = Astro.props;
const t = copy[lang];
const otherLang: Locale = lang === 'es' ? 'en' : 'es';
const isDashboardPage = currentPage === 'dashboards';
const homePath = `/${lang}/`;
const dashboardPath = `/${lang}/dashboards/`;
const otherPath = isDashboardPage ? `/${otherLang}/dashboards/` : `/${otherLang}/`;
const sectionPath = (section: string) => isDashboardPage ? `${homePath}${section}` : section;
---

<header class="site-header">
  <a class="brand" href={homePath} aria-label={`${profile.name} — ${profile.role[lang]}`}>
    <span class="brand-mark"><Icon name="database" size={18} /></span>
    <span>{profile.name}</span>
  </a>
  <nav class="primary-nav" aria-label={lang === 'es' ? 'Navegación principal' : 'Primary navigation'}>
    <a href={sectionPath('#about')}>{t.nav.about}</a>
    <a href={sectionPath('#projects')}>{t.nav.projects}</a>
    <a href={dashboardPath} aria-current={isDashboardPage ? 'page' : undefined}>{t.nav.dashboards}</a>
    <a href={sectionPath('#certifications')}>{t.nav.certifications}</a>
    <a href={sectionPath('#experience')}>{t.nav.experience}</a>
    <a href={sectionPath('#education')}>{t.nav.education}</a>
  </nav>
  <a class="language-switch" href={otherPath} data-language={otherLang} aria-label={t.switchLabel}>
    <span>{t.languageName}</span>
    <span class="switch-track" aria-hidden="true"><span></span></span>
    <span>{otherLang.toUpperCase()}</span>
  </a>
</header>
<a class="mobile-language-switch" href={otherPath} data-language={otherLang} aria-label={t.switchLabel}>
  <span>{t.languageName}</span>
  <span class="switch-track" aria-hidden="true"><span></span></span>
  <span>{otherLang.toUpperCase()}</span>
</a>

<script is:inline>
  document.querySelectorAll('[data-language]').forEach((link) => {
    link.addEventListener('click', () => localStorage.setItem('portfolio-language', link.getAttribute('data-language')));
  });
</script>
