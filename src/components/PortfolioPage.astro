---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import {
  certifications,
  copy,
  education,
  experience,
  profile,
  projects,
  type Locale,
  type TimelineEntry,
} from '../data/portfolio';

interface Props { lang: Locale }

const { lang } = Astro.props;
const t = copy[lang];
const pageTitle = `${profile.name} — ${profile.role[lang]}`;
const pageDescription = lang === 'es'
  ? 'Portafolio de ingeniería de datos: proyectos, experiencia, formación y certificaciones cloud.'
  : 'Data engineering portfolio: projects, experience, education, and cloud certifications.';

const timeline = (items: TimelineEntry[]) => items.map((item) => ({
  ...item,
  localizedTitle: item.title[lang],
  localizedPeriod: item.period[lang],
  localizedDescription: item.description[lang],
}));
---

<BaseLayout lang={lang} title={pageTitle} description={pageDescription} canonicalPath={`/${lang}/`}>
  <a class="skip-link" href="#main">{t.skip}</a>
  <div class="ambient-grid" aria-hidden="true"></div>

  <SiteHeader lang={lang} currentPage="home" />

  <main id="main">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow hero-step">{t.eyebrow}</p>
        <div class="availability hero-step"><span></span>{t.available}</div>
        <h1 id="hero-title" class="hero-step">
          <span>{profile.name}</span>
          <strong>{profile.role[lang]}</strong>
        </h1>
        <p class="hero-lead hero-step">{t.heroLead}</p>
        <div class="hero-actions hero-step">
          <a class="button button-secondary" href="#projects">
            {t.viewProjects}<Icon name="arrow" />
          </a>
          <a class="button button-secondary" href={`/${lang}/dashboards/`}>
            {t.viewDashboards}<Icon name="arrow" />
          </a>
        </div>
      </div>

      <div class="portrait-panel hero-step">
        <div class="panel-meta"><span>INPUT_01</span><span>PORTRAIT.JPG</span></div>
        <Image src={profile.portrait} alt={lang === 'es' ? `Retrato de ${profile.name}` : `Portrait of ${profile.name}`} widths={[480, 720]} sizes="(max-width: 900px) 80vw, 38vw" />
        <div class="portrait-caption">
          <span>{profile.location}</span>
          <span>02°54′S / 79°00′W</span>
        </div>
      </div>
      <div class="hero-index" aria-hidden="true">00</div>
    </section>

    <div class="pipeline" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>

    <section id="about" class="content-section section-shell reveal" aria-labelledby="about-title">
      <div class="section-heading">
        <p class="section-kicker">{t.aboutKicker}</p>
        <h2 id="about-title">{t.about}</h2>
      </div>
      <div class="about-content">
        <p class="about-lead">{t.aboutText}</p>
        <div class="stats-grid">
          {t.stats.map(([value, label]) => (
            <div class="stat"><strong>{value}</strong><span>{label}</span></div>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" class="content-section section-shell reveal" aria-labelledby="projects-title">
      <div class="section-heading section-heading-row">
        <div><p class="section-kicker">{t.projectsKicker}</p><h2 id="projects-title">{t.projects}</h2></div>
        <p class="section-note">{t.projectHint}</p>
      </div>
      <div class="projects-grid">
        {projects.map((project, index) => (
          <article class="project-card project-card-text">
            <span class="project-number">0{index + 1}</span>
            <div class="project-body">
              <h3>
                <a
                  class="project-title-link"
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.title[lang]} — GitHub`}
                >
                  {project.title[lang]}
                </a>
              </h3>
              <p>{project.description[lang]}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="certifications" class="content-section section-shell reveal" aria-labelledby="certifications-title">
      <div class="cert-intro">
        <div class="section-heading"><p class="section-kicker">{t.certificationsKicker}</p><h2 id="certifications-title">{t.certifications}</h2></div>
        <p>{t.certificationText}</p>
      </div>
      <ul class="cert-grid">
        {certifications.map((certification) => (
          <li class="cert-card" title={`${certification.name} — ${certification.issuer}`}>
            <a
              href={certification.credentialUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver credencial de ${certification.name}`}
            >
              <Image src={certification.logo} alt={`${certification.name}, ${certification.issuer}`} loading="lazy" />
            </a>
            <span class="sr-only">{certification.name} — {certification.issuer}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="experience" class="content-section section-shell reveal" aria-labelledby="experience-title">
      <div class="section-heading"><p class="section-kicker">{t.experienceKicker}</p><h2 id="experience-title">{t.experience}</h2></div>
      <div class="timeline">
        {timeline(experience).map((item, index) => (
          <article class="timeline-item">
            <div class="timeline-marker"><span>0{index + 1}</span></div>
            <div class="timeline-date">{item.localizedPeriod}</div>
            <div class="timeline-body">
              <p class="organization">{item.organization}</p>
              <h3>{item.localizedTitle}</h3>
              <p>{item.localizedDescription}</p>
              {item.tags && <ul class="tag-list">{item.tags.map((tag) => <li>{tag}</li>)}</ul>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="education" class="content-section section-shell reveal" aria-labelledby="education-title">
      <div class="section-heading"><p class="section-kicker">{t.educationKicker}</p><h2 id="education-title">{t.education}</h2></div>
      <div class="timeline compact">
        {timeline(education).map((item, index) => (
          <article class="timeline-item">
            <div class="timeline-marker"><span>0{index + 1}</span></div>
            <div class="timeline-date">{item.localizedPeriod}</div>
            <div class="timeline-body">
              <p class="organization">{item.organization}</p>
              <h3>{item.localizedTitle}</h3>
              <p>{item.localizedDescription}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} />

  <script is:inline>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
  </script>
</BaseLayout>
