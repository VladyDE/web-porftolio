---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="es" title="404 — Route not found" description="The requested route was not found." canonicalPath="/404/">
  <main class="error-page">
    <p class="section-kicker">ERROR / 404</p>
    <h1>Route not found.<br /><strong>Ruta no encontrada.</strong></h1>
    <p>The requested data point does not exist. / El punto de datos solicitado no existe.</p>
    <a class="button" href="/">Return to input / Volver al inicio <span aria-hidden="true">→</span></a>
  </main>
</BaseLayout>
